<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Grid Suite"
        parallel="tests"
        thread-count="4">

    <test name="Chrome">

        <parameter name="browser"
                    value="chrome"/>

        <classes>

            <class name=
            "tests.ui.LoginTest"/>

        </classes>

    </test>

    <test name="Firefox">

        <parameter name="browser"
                    value="firefox"/>

        <classes>

            <class name=
            "tests.ui.LoginTest"/>

        </classes>

    </test>

</suite>